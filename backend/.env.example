# ===================================================
# TANGARA 2026 - Variables de entorno del backend
# Copia este archivo como .env y rellena con las credenciales
# de ClickHouse entregadas por los organizadores.
# NUNCA subas el archivo .env a git.
# ===================================================

# --- Conexión ClickHouse (infra de Tangara) ---
CLICKHOUSE_HOST=your-clickhouse-host.example.com
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=tu_usuario
CLICKHOUSE_PASSWORD=tu_password
CLICKHOUSE_DATABASE=tangara_plata
# true si el host usa HTTPS/TLS (normalmente sí en puertos 8443)
CLICKHOUSE_SECURE=true

# --- App ---
# Orígenes permitidos por CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TTL de la caché en segundos para consultas agregadas
CACHE_TTL_SECONDS=300

# (Opcional, para el chatbot con IA — se usará más adelante)
# ANTHROPIC_API_KEY=
